        "prefix": "sstry",
        "scope": "javascript",
        "body": [
            "try {",
            "\t${1:// ...}",
            "} catch (e) {",
            "\tlog.error({",
            "\t\ttitle: '${2:Error in ${TM_FILENAME_BASE}}',",
            "\t\tdetails: e,",
            "\t});",
            "\tthrow e;${0:}",
            "}"
        ],
        "description": "try/catch with log.error (rethrows)"
    },
    "Log Audit": {
        "prefix": "sslog",
        "scope": "javascript",
        "body": [
            "log.${1|audit,debug,error,emergency|}({",
            "\ttitle: '${2:title}',",
            "\tdetails: ${3:details},",
            "});"
        ],
        "description": "Log a message with N/log"
    },
    "Client Current Record": {
        "prefix": "sscurrentrecord",
        "scope": "javascript",
        "body": [
            "const rec = currentRecord.get();",
            "const ${1:value} = rec.getValue({ fieldId: '${2:fieldId}' });",
